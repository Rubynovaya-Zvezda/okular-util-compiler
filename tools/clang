#!/bin/sh
# Compiler entry point: run the okc binary produced by the okc_repo repository
# rule. The toolchain declares that binary as an input, so Bazel fetches/builds
# it before any compile action; fallback to plain clang if it is unavailable.
for okc in external/*okc_repo*okc_tool/okc; do
    if [ -x "$okc" ]; then
        exec "$okc" "$@"
    fi
done
exec clang "$@"
