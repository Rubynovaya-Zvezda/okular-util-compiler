#!/bin/sh
# Bootstrap wrapper: compile okc from this module's sources with clang on first
# use, cache the binary in the module's external repo, then run it.
src=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1
out="$src/okc-tool-bin"
if [ ! -x "$out" ]; then
    clang -std=c23 -O2 -o "$out" \
        "$src/okc.c" "$src/space-cc.c" "$src/space-transform.c" \
        "$src/space_rewrite.c" || exit 1
fi
exec "$out" "$@"
