load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_toolchain")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

COPTS = ["-std=c23", "-Wall", "-Wextra"]

cc_library(
    name = "space_rewrite",
    srcs = ["space_rewrite.c"],
    hdrs = ["space_rewrite.h"],
    includes = ["."],
    copts = COPTS,
)

cc_library(
    name = "space_cc",
    srcs = ["space-cc.c"],
    hdrs = ["space-cc.h"],
    deps = [":space_rewrite"],
    copts = COPTS,
)

cc_library(
    name = "space_transform",
    srcs = ["space-transform.c"],
    hdrs = ["space-transform.h"],
    deps = [":space_rewrite"],
    copts = COPTS,
)

cc_library(
    name = "space_lsp",
    srcs = ["space-lsp.c"],
    hdrs = ["space-lsp.h"],
    deps = [":space_rewrite"],
    copts = COPTS,
)

cc_binary(
    name = "okc",
    srcs = ["okc.c"],
    deps = [
        ":space_cc",
        ":space_lsp",
        ":space_transform",
    ],
    copts = COPTS,
)

sh_binary(
    name = "install_okc",
    srcs = ["install-okc.sh"],
    data = [":okc"],
)

filegroup(
    name = "vim_plugin",
    srcs = glob(["vim/**"], exclude = ["**/node_modules/**"]),
)

filegroup(
    name = "coc_okc",
    srcs = glob(["coc-okc/**"], exclude = ["**/node_modules/**"]),
)

sh_test(
    name = "hook_tests",
    srcs = ["tests/run.sh"],
    data = [
        ":okc",
        ":vim_plugin",
        ":coc_okc",
        "install-okc.sh",
        "readme.md",
    ],
)

LOCAL = "@local_config_cc//"

filegroup(name = "okc_files", srcs = ["@okc_tool//:okc", "@okc_tool//:clang", "//tools:clang"])

cc_toolchain(
    name = "release_impl",
    all_files = ":okc_files",
    ar_files = ":okc_files",
    as_files = ":okc_files",
    compiler_files = ":okc_files",
    dwp_files = LOCAL + ":empty",
    linker_files = ":okc_files",
    objcopy_files = LOCAL + ":empty",
    strip_files = LOCAL + ":empty",
    toolchain_config = "//tools:okc_config",
    toolchain_identifier = "okc",
)

toolchain(
    name = "release",
    toolchain = ":release_impl",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)
